# ============================================================
# MediStore: Temple of Asclepius — environment template
# Copy to .env.local (gitignored) for local development, and set
# the same keys in Vercel → Project → Settings → Environment
# Variables (Production / Preview / Development).
# All values below are intentionally EMPTY.
# ============================================================

# ---- Server secrets (Vercel Environment Variables; never exposed to the browser) ----
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
NODE_ENV=
GEMINI_API_KEY=
GEMINI_MODEL=
CSP_CONNECT_EXTRA=

# ---- Client VITE_ vars (build-time; inlined into the browser bundle by Vite) ----
VITE_WEB3_MODE=
VITE_BATCH_REGISTRY_ADDRESS=
VITE_SEPOLIA_RPC_URL=
VITE_TERMINAL_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
