# Server Configuration
PORT=5000
NODE_ENV=development
SESSION_SECRET=
CSP_CONNECT_EXTRA=

# Optional Database Keys (Plug-and-Play)
# If provided, MediStore automatically connects, provisions schemas, and persists data.
# If unset, MediStore seamlessly runs with its high-performance in-memory store.
# PostgreSQL (Supabase / Neon / Railway / Vercel Postgres / AWS RDS):
DATABASE_URL=
# MongoDB (Atlas / Self-hosted):
MONGODB_URI=

# Client Configuration (Vite)
VITE_WEB3_MODE=mock
VITE_BATCH_REGISTRY_ADDRESS=
VITE_SEPOLIA_RPC_URL=
VITE_TERMINAL_WS_URL=
