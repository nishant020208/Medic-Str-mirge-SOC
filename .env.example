# Server Configuration
PORT=5000
NODE_ENV=development
SESSION_SECRET=
CSP_CONNECT_EXTRA=

# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Database Keys (Plug-and-Play)
# If provided, MediStore automatically connects, provisions schemas, and persists data.
# If unset, MediStore seamlessly runs with its high-performance in-memory store.
# PostgreSQL (Supabase / Neon / Railway / Vercel Postgres / AWS RDS):
DATABASE_URL=
# MongoDB (Atlas / Self-hosted):
MONGODB_URI=

# Pythia Oracle AI (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Client Configuration (Vite) - These are exposed to the browser
VITE_WEB3_MODE=mock
VITE_BATCH_REGISTRY_ADDRESS=
VITE_SEPOLIA_RPC_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TERMINAL_API_URL=
