{
  "name": "medistore-asclepius",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MediStore: Temple of Asclepius - Hackathon Victim Application",
  "overrides": {
    "braces": "^3.0.3",
    "@vitest/mocker": "^4.1.11"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"cyan,magenta\" \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "preview:vercel": "vercel dev --listen 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "npm run lint -w client && npm run lint -w server",
    "lint:colors": "npx tsx scripts/lint-colors.ts",
    "test:contrast": "npx tsx scripts/check-contrast.ts",
    "seed": "npm run seed -w server",
    "db:migrate": "npx tsx scripts/db-migrate.ts",
    "db:seed": "npx tsx scripts/db-seed.ts",
    "audit:lighthouse": "node scripts/run-lighthouse.js",
    "test:lighthouse": "node scripts/run-lighthouse.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.50.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "22.x"
  }
}
