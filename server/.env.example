PORT=5000
NODE_ENV=development
SESSION_SECRET=
CSP_CONNECT_EXTRA=

# Optional Database Keys (Plug-and-Play)
# If provided, MediStore automatically connects, provisions tables, and syncs data.
# If unset, MediStore seamlessly runs with its high-performance in-memory store.
# PostgreSQL (Supabase / Neon / Railway / Vercel Postgres / AWS RDS):
DATABASE_URL=
# MongoDB (Atlas / Self-hosted):
MONGODB_URI=

# Pythia Oracle AI (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

