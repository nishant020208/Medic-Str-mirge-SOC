{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "regions": ["hnd1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 10,
      "includeFiles": "{client/dist/**,client/src/App.tsx}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api"
    },
    {
      "source": "/healthz",
      "destination": "/api"
    },
    {
      "source": "/admin-old",
      "destination": "/api"
    },
    {
      "source": "/admin-old/:match*",
      "destination": "/api"
    },
    {
      "source": "/.env",
      "destination": "/api"
    },
    {
      "source": "/.env/:match*",
      "destination": "/api"
    },
    {
      "source": "/backup.zip",
      "destination": "/api"
    },
    {
      "source": "/backup.zip/:match*",
      "destination": "/api"
    },
    {
      "source": "/wp-login.php",
      "destination": "/api"
    },
    {
      "source": "/wp-login.php/:match*",
      "destination": "/api"
    },
    {
      "source": "/phpmyadmin",
      "destination": "/api"
    },
    {
      "source": "/phpmyadmin/:match*",
      "destination": "/api"
    },
    {
      "source": "/api/v1/internal/keys",
      "destination": "/api"
    },
    {
      "source": "/api/v1/internal/keys/:match*",
      "destination": "/api"
    },
    {
      "source": "/:match*",
      "destination": "/api"
    }
  ]
}
